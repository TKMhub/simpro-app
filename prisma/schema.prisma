generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogPost {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  author          String
  category        String     @default("")
  tags            String[]
  status          PostStatus @default(draft)
  isPublic        Boolean    @default(false)
  goodCount       Int        @default(0)
  headerImagePath String?
  notionPageId    String     @unique
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([category])
  @@index([status, isPublic])
  @@index([slug])
  @@index([tags])
}

model ProductPost {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  description     String            @default("")
  author          String
  category        String            @default("")
  type            ProductType
  tags            String[]
  status          PostStatus        @default(draft)
  isPublic        Boolean           @default(false)
  goodCount       Int               @default(0)
  headerImagePath String?
  notionPageId    String            @unique
  contentLink     String?
  actionType      ProductActionType @default(transition)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([category])
  @@index([status, isPublic])
  @@index([slug])
  @@index([tags])
  @@index([type])
}

model Profile {
  id                   String              @id @default(uuid())
  email                String
  displayName          String?
  avatarUrl            String?
  joinedApps           String[]            @default([])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bio                  String?
  // User Active Status
  isActive             Boolean             @default(false)
  zaikoCreatedFamilies ZaikoFamily[]       @relation("CreatedFamilies")
  zaikoMemberships     ZaikoFamilyMember[]
  
  @@map("profiles")
}

model ZaikoFamily {
  id         String              @id @default(uuid())
  name       String
  inviteCode String              @unique
  createdBy  String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  creator    Profile             @relation("CreatedFamilies", fields: [createdBy], references: [id])
  members    ZaikoFamilyMember[]
  items      ZaikoItem[]
  categories ZaikoCategory[]
  locations  ZaikoLocation[]
  
  @@map("zaiko_families")
}

model ZaikoFamilyMember {
  id       String          @id @default(uuid())
  familyId String
  userId   String
  role     ZaikoFamilyRole @default(EDITOR)
  joinedAt DateTime        @default(now())
  family   ZaikoFamily     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([familyId, userId])
  @@map("zaiko_family_members")
}

model ZaikoItem {
  id        String      @id @default(uuid())
  familyId  String
  name      String
  quantity  Int         @default(1)
  threshold Int         @default(1)
  category  String      @default("日用品")
  location  String?
  icon      String      @default("box")
  memo      String?
  createdBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  family    ZaikoFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  
  @@index([familyId])
  @@map("zaiko_items")
}

model ZaikoCategory {
  id        String      @id @default(uuid())
  familyId  String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  family    ZaikoFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@map("zaiko_categories")
}

model ZaikoLocation {
  id        String      @id @default(uuid())
  familyId  String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  family    ZaikoFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@map("zaiko_locations")
}

enum PostStatus {
  draft
  published
  archived
}

enum ProductType {
  Tool
  Template
  Service
}

enum ProductActionType {
  transition
  download
}

enum ZaikoFamilyRole {
  ADMIN
  EDITOR
  VIEWER
}
