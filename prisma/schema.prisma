// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // ← プーラー(6543)でもOK
  directUrl = env("DIRECT_URL")     // ← 直結(5432)を必ず指定
}

// Blog schema

enum PostStatus {
  draft
  published
  archived
}

model BlogPost {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  author          String
  category        String      @default("")
  tags            String[]    @db.Text
  status          PostStatus  @default(draft)
  isPublic        Boolean     @default(false)
  goodCount       Int         @default(0)
  headerImagePath String?
  notionPageId    String      @unique
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([category])
  @@index([status, isPublic])
  @@index([slug])
  @@index([tags])
}

// Product schema (similar to BlogPost with product-specific fields)

enum ProductType {
  Tool
  Template
  Service
}

enum ProductActionType {
  transition
  download
}

model ProductPost {
  id              String             @id @default(uuid())
  title           String
  slug            String             @unique
  description     String             @default("")
  author          String
  category        String             @default("")
  type            ProductType
  tags            String[]           @db.Text
  status          PostStatus         @default(draft)
  isPublic        Boolean            @default(false)
  goodCount       Int                @default(0)
  headerImagePath String?
  notionPageId    String             @unique
  contentLink     String?
  actionType      ProductActionType  @default(transition)
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category])
  @@index([status, isPublic])
  @@index([slug])
  @@index([tags])
  @@index([type])
}

// -----------------------------------------------------------------------------
// Zaiko Schema
// -----------------------------------------------------------------------------

// 公開プロフィールテーブル
// Supabase Auth (auth.users) だけではアプリ固有のユーザー情報（表示名やアバター、関連データへのリレーションなど）を
// 扱いづらいため、publicスキーマにProfilesテーブルを作成して auth.users と1:1で同期させることが推奨されています。
// https://supabase.com/docs/guides/auth/managing-user-data#using-a-public-profile-table
model ZaikoProfile {
  id           String   @id @default(uuid()) // auth.users.id と同期
  email        String
  displayName  String?
  avatarUrl    String?
  
  createdFamilies ZaikoFamily[] @relation("CreatedFamilies")
  memberships     ZaikoFamilyMember[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("zaiko_profiles")
}

model ZaikoFamily {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique
  
  createdBy   String
  creator     ZaikoProfile  @relation("CreatedFamilies", fields: [createdBy], references: [id])
  
  members     ZaikoFamilyMember[]
  items       ZaikoItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("zaiko_families")
}

enum ZaikoFamilyRole {
  ADMIN
  EDITOR
  VIEWER
}

model ZaikoFamilyMember {
  id        String     @id @default(uuid())
  familyId  String
  userId    String
  role      ZaikoFamilyRole @default(EDITOR)
  
  family    ZaikoFamily     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      ZaikoProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  joinedAt  DateTime   @default(now())
  
  @@unique([familyId, userId]) // 1ユーザーは1家族に1つだけメンバーレコードを持つ
  @@map("zaiko_family_members")
}

model ZaikoItem {
  id          String   @id @default(uuid())
  familyId    String
  name        String
  quantity    Int      @default(1)
  threshold   Int      @default(1)
  category    String   @default("日用品") // アプリ側定数と同期
  location    String?
  icon        String   @default("box")
  memo        String?
  
  family      ZaikoFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  
  createdBy   String?  // ZaikoProfile.id
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([familyId])
  @@map("zaiko_items")
}
